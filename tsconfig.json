{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "skipLibCheck": false
  },
  "include": [
    "repo-overlay/scripts/**/*.ts",
    "architectures/*/repo-overlay/scripts/**/*.ts"
  ]
}
