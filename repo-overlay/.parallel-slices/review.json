{
  "$schema": "./review.schema.json",
  "version": 1,
  "enabled": true,
  "billingPolicy": "subscription-only",
  "turnTimeoutSeconds": 3600,
  "overallTimeoutSeconds": 18000,
  "authWaitSeconds": 900,
  "reviewers": [
    {
      "id": "claude-code-review",
      "provider": "claude-code",
      "model": "claude-opus-5",
      "effort": "xhigh"
    },
    {
      "id": "codex-review",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "effort": "xhigh"
    }
  ]
}
